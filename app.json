{
  "expo": {
    "name": "Nabd Gym",
    "slug": "khenov-demo-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "khenovdemogym",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E1116",
    "android": {
      "package": "com.khenov.demo.gym",
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Nabd Gym · Demo by KHENOV",
      "shortName": "Nabd Gym",
      "description": "Nabd Gym is a demo gym member app by KHENOV. All data is fictional. · تطبيق تجريبي لصالة رياضية من KHENOV، وكل بياناته وهمية.",
      "themeColor": "#0E1116",
      "lang": "ar",
      "backgroundColor": "#0E1116"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1116",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "description": "Nabd Gym is a demo gym member app by KHENOV. All data is fictional. · تطبيق تجريبي لصالة رياضية من KHENOV، وكل بياناته وهمية.",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bd9f596d-9c10-43b3-a0ef-5c01adb61907"
      }
    }
  }
}
